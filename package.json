{
  "name": "choreo",
  "version": "0.1.0",
  "description": "Local orchestration for coding CLIs",
  "type": "module",
  "bin": {
    "choreo": "bin/choreo.js"
  },
  "files": [
    "bin/",
    "server/src/**/*.ts",
    "!server/src/**/*.test.ts",
    "protocol/index.ts",
    "web/",
    "fixture/",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sams222/Choreo.git"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "choreo": "tsx server/src/cli.ts",
    "test": "tsx --test server/src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
